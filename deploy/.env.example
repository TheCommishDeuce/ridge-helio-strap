# Copy to deploy/.env and fill in. deploy/.env is ignored by git; keep it private.

# Database password. Generate one with:  openssl rand -hex 24
# Only read when the database is first created; changing it later needs ALTER ROLE.
POSTGRES_PASSWORD=

# Your IANA timezone (e.g. Europe/Berlin): days are cut at your local midnight.
OWNER_TIMEZONE=UTC

# SHA-256 of the phone's token. Do not type it: deploy/new-token.sh writes it and prints the
# token once for the app.
DEVICE_TOKEN_SHA256=

# Where the API listens (plain HTTP, for the reverse proxy). Keep it off the internet.
RIDGE_BIND=127.0.0.1
RIDGE_PORT=8766
