<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone by backup or device transfer: the sealed auth key is useless
     without this device's Keystore key, and the health data belongs on the owner's server. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
